{
  "name": "zeldammo",
  "version": "0.0.1",
  "description": "A recreation of Zelda link's awakening using phaser and colyseum",
  "homepage": "http://zelda.herokuapp.com",
  "repository": {
    "type": "git",
    "url": "git://github.com/jerzual/zeldammo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node server",
    "start": "node server",
    "build": "npm run build:client && npm run build:server && npm run build:game-server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:game-server": "vite build --ssr src/server/game-server.ts --outDir dist/game",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:check": "oxlint --check",
    "preview": "cross-env NODE_ENV=production node server",
    "test": "vitest"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "colyseus.js": "^0.16.22",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "leva": "^0.10.1",
    "nanoid": "^5.1.11",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sirv": "^3.0.2",
    "three": "^0.184.0",
    "vite": "^8.0.16",
    "znv": "^0.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.x"
  }
}
