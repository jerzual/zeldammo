{
  "name": "zeldammo",
  "version": "0.0.1",
  "description": "A recreation of Zelda link's awakening using phaser and colyseum",
  "homepage": "http://zelda.herokuapp.com",
  "repository": {
    "type": "git",
    "url": "git://github.com/jerzual/zeldammo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node server",
    "start": "node server",
    "build": "npm run build:client && npm run build:server && npm run build:game-server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:game-server": "vite build --ssr src/server/game-server.ts --outDir dist/game",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:check": "oxlint --format=github",
    "preview": "cross-env NODE_ENV=production node server",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "leva": "^0.10.1",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sirv": "^3.0.2",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.69.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.x"
  }
}
